# ==============================================================================
# ASSURED INSURANCE SERVICES — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env on the production VPS and update each value.
# Restrict file permissions: chmod 600 .env
# NEVER commit the actual .env file or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
# The fully qualified domain name pointing to the VPS (must have A/AAAA DNS records).
APP_DOMAIN=affiliates.example.com

# Contact email for automatic Let's Encrypt TLS certificate issuance via Caddy.
TLS_EMAIL=admin@example.com

# Node environment and server runtime binding.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_VERSION=1.0.0
GIT_SHA=unknown

# Docker image deployed by CI/CD (populated automatically by deployment script).
APP_IMAGE=ghcr.io/your-github-username/pay_per_call:latest

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL is isolated on a private Docker bridge network and never exposed publicly.
# Database name.
POSTGRES_DB=assured

# Migration User: Possesses schema DDL privileges. Used exclusively by migration runs.
POSTGRES_USER=assured_migrator
POSTGRES_PASSWORD=generate_a_very_strong_password_for_migrator_here

# Application Runtime User: Restricted least-privilege user (DML only: SELECT, INSERT, UPDATE, DELETE).
APP_DB_USER=assured_app
APP_DB_PASSWORD=generate_a_very_strong_password_for_app_here

# Runtime database connection URL used by Next.js and worker services.
DATABASE_URL=postgres://assured_app:generate_a_very_strong_password_for_app_here@postgres:5432/assured

# Migration database connection URL used only during automated migration runs.
DATABASE_MIGRATE_URL=postgres://assured_migrator:generate_a_very_strong_password_for_migrator_here@postgres:5432/assured

# Maximum connections in the application pool.
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Administrator dashboard login credentials (/admin/login).
ADMIN_EMAIL=justin.bennett@assuredinsuranceservices.com
ADMIN_PASSWORD=generate_a_high_entropy_random_password_for_admin_portal

# Secret key used for signing and verifying administrator session JWTs (minimum 32 characters).
# Generate with: openssl rand -base64 48
SESSION_SECRET=generate_at_least_32_character_high_entropy_secret_key_here

# Salt for hashing submitter IP addresses before storing in rate-limit events.
# Generate with: openssl rand -hex 24
RATE_LIMIT_SALT=generate_a_unique_salt_string_for_ip_hashing_here

# ------------------------------------------------------------------------------
# 4. REGISTRATION & ABUSE PREVENTION CONTROLS
# ------------------------------------------------------------------------------
# Set to 'true' to restrict affiliate applications strictly to @gmail.com addresses.
# Set to 'false' to allow any valid corporate or personal email address.
GMAIL_ONLY_REGISTRATION=false

# Rate limiting: Maximum submissions allowed from a single hashed IP within the window.
SUBMIT_RATE_LIMIT=5
SUBMIT_RATE_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# 5. EMAIL CONFIGURATION (Hostinger Authenticated SMTP)
# ------------------------------------------------------------------------------
# Use Hostinger SMTP parameters with an authenticated domain mailbox.
# Note: Do not use the administrator Gmail address as SMTP_USER; Hostinger SMTP requires
# authentication using your actual Hostinger domain mailbox account.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your_hostinger_mailbox_password_here
MAIL_FROM="Assured Insurance Services" <notifications@yourdomain.com>

# Outbox queue worker controls.
EMAIL_MAX_ATTEMPTS=8
EMAIL_BATCH_SIZE=10
EMAIL_POLL_MS=15000

# ------------------------------------------------------------------------------
# 6. BACKUP & DISASTER RECOVERY
# ------------------------------------------------------------------------------
# Backup schedule interval (in seconds; 86400 = once daily).
BACKUP_INTERVAL_SECONDS=86400

# Retention window for local compressed database dumps (days).
BACKUP_RETENTION_DAYS=14

# Optional: Encrypted offsite Amazon S3 or Cloudflare R2 bucket name.
# Leave blank for local volume backups only. If configured, ensure AWS CLI credentials
# are configured or mounted.
BACKUP_S3_BUCKET=
